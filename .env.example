# URL de conexão do Postgres usada pelo Prisma. Deve usar a mesma porta de POSTGRES_PORT.
DATABASE_URL="postgresql://admin:admin@localhost:5433/bookreview"

# URL pública base da aplicação, exposta ao cliente (prefixo NEXT_PUBLIC_).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Porta local publicada pelo container do Postgres no docker-compose.yml (padrão 5433 para evitar conflito com outros projetos).
POSTGRES_PORT=5433

# Ambiente de execução. Normalmente definido automaticamente pelo Next.js/Node; raramente precisa ser setado à mão.
# NODE_ENV="development"

# Pula a validação de variáveis de ambiente em src/lib/env.ts (útil em CI e builds de imagem Docker sem acesso ao .env real).
# SKIP_ENV_VALIDATION=""

# Chave usada pelo BetterAuth para assinar sessão/cookies. Obrigatória, mínimo 32 caracteres.
# Gere uma com: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# URL base que o BetterAuth usa para montar callbacks de OAuth. Se vazio, cai para NEXT_PUBLIC_APP_URL.
# BETTER_AUTH_URL="http://localhost:3000"

# Login social com Google. Opcional: sem as duas, o botão "Entrar com Google" some da UI.
# Crie em https://console.cloud.google.com/apis/credentials (OAuth client ID, tipo "Web application")
# Callback a registrar: {BETTER_AUTH_URL ou NEXT_PUBLIC_APP_URL}/api/auth/callback/google
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# Login social com GitHub. Opcional: sem as duas, o botão "Entrar com GitHub" some da UI.
# Crie em https://github.com/settings/developers (OAuth Apps > New OAuth App)
# Callback a registrar: {BETTER_AUTH_URL ou NEXT_PUBLIC_APP_URL}/api/auth/callback/github
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""
